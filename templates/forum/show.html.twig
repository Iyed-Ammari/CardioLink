{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-5" style="max-width: 800px;">
    <a href="{{ path('forum_frontoffice') }}" class="btn btn-link text-decoration-none mb-3">
        <i class="fas fa-arrow-left"></i> Retour au forum
    </a>

    <article style="border-radius:18px; background:white; border:1px solid #e5e7eb; padding:2rem; box-shadow:0 10px 30px rgba(0,0,0,0.05);">
        <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1.5rem;">
            <div style="width:50px; height:50px; border-radius:50%; background:#2F60F5; color:white; display:flex; align-items:center; justify-content:center; font-weight:bold;">
                {{ post.user.nom|first }}
            </div>
            <div>
                <h4 style="margin:0; font-weight:700;">{{ post.title }}</h4>
                <small class="text-muted">Par {{ post.user.nom }} {{ post.user.prenom }} • {{ post.createdAT|date('d/m/Y H:i') }}</small>
            </div>
        </div>

        <p style="font-size:1.1rem; line-height:1.6; color:#374151;">
            {{ post.content }}
        </p>
    </article>

    <div class="mt-5">
        <h5 style="font-weight:700; margin-bottom:1.5rem;">
            <i class="far fa-comments"></i> Commentaires ({{ comments|length }})
        </h5>

        {% for comment in comments %}
            <div style="background:#f8fafc; border-radius:12px; padding:1.2rem; margin-bottom:1rem; border-left:4px solid #2F60F5;">
                <div style="display:flex; justify-content:space-between; margin-bottom:0.5rem;">
                    <strong>{{ comment.user.nom }} {{ comment.user.prenom }}</strong>
                    <small class="text-muted">{{ comment.createdAt|date('d/m/Y') }}</small>
                </div>
                <p style="margin:0; color:#4b5563;">{{ comment.content }}</p>
            </div>
        {% else %}
            <p class="text-muted italic">Aucun commentaire pour le moment. Soyez le premier à répondre !</p>
        {% endfor %}
    </div>
</div>
{% endblock %}