{# templates/admin/forum_backoffice.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}CardioLink | Administration Community{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --admin-primary: #2F60F5;
            --admin-secondary: #F82239;
            --admin-bg: #f4f7fe;
            --card-shadow: 0 10px 30px rgba(47, 96, 245, 0.08);
        }

        /* On ajuste le main-content pour le backoffice */
        .admin-page-wrapper {
            display: flex;
            margin: -2rem; /* Annule le padding par défaut du main de base si nécessaire */
            min-height: calc(100vh - 60px);
            background-color: var(--admin-bg);
        }

        /* Sidebar interne */
        .admin-sidebar {
            width: 280px;
            background: white;
            border-right: 1px solid #e5e7eb;
            padding: 2rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .admin-nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0.8rem 1rem;
            color: #64748b;
            text-decoration: none;
            border-radius: 12px;
            font-weight: 600;
            transition: 0.3s;
        }

        .admin-nav-link:hover, .admin-nav-link.active {
            background: #eff6ff;
            color: var(--admin-primary);
        }

        /* Zone de contenu principale */
        .admin-main {
            flex: 1;
            padding: 2.5rem;
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        /* Cartes de posts */
        .admin-post-card {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: var(--card-shadow);
            border: 1px solid #edf2f7;
        }

        .admin-badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            background: #eff6ff;
            color: var(--admin-primary);
        }

        .btn-action {
            padding: 0.6rem 1.2rem;
            border-radius: 10px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-del {
            background: linear-gradient(45deg, var(--admin-secondary), #d90429);
            color: white;
        }

        .btn-view {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            color: #1e293b;
        }

        /* Stats à droite */
        .admin-grid {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 2rem;
        }

        .stat-box {
            background: white;
            padding: 1.5rem;
            border-radius: 20px;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            box-shadow: var(--card-shadow);
        }

        .stat-icon {
            width: 48px; height: 48px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem;
        }
    </style>
{% endblock %}

{% block body %}
<div class="admin-page-wrapper">
    <aside class="admin-sidebar">
        <h3 style="padding-left: 1rem; font-size: 0.9rem; color: #94a3b8; text-transform: uppercase;">Management</h3>
        <a href="#" class="admin-nav-link active"><i class="fas fa-users"></i> Community</a>
        <a href="#" class="admin-nav-link"><i class="fas fa-chart-line"></i> Analytics</a>
        <a href="#" class="admin-nav-link"><i class="fas fa-shield-alt"></i> Modération</a>
        
        <hr style="border: 0; border-top: 1px solid #f1f5f9; margin: 1rem 0;">
        
        <a href="{{ path('forum_frontoffice') }}" class="admin-nav-link" style="color: var(--admin-primary);">
            <i class="fas fa-arrow-left"></i> Retour au Forum
        </a>
    </aside>

    <div class="admin-main">
        <div class="admin-header">
            <div>
                <h1 style="margin:0; font-weight: 800; color: #1e293b;">Gestion de la Communauté</h1>
                <p style="color: #64748b; margin: 5px 0 0 0;">Contrôlez et modérez les publications patients.</p>
            </div>
            
            <div style="display: flex; gap: 1rem;">
                <input type="text" id="search-admin" placeholder="Filtrer les titres..." 
                       style="padding: 0.7rem 1.2rem; border-radius: 12px; border: 1px solid #e2e8f0; width: 250px;">
                <select id="sort-admin" style="padding: 0.7rem; border-radius: 12px; border: 1px solid #e2e8f0;">
                    <option value="recent">Plus récents</option>
                    <option value="titre">Titre A-Z</option>
                </select>
            </div>
        </div>

        <div class="admin-grid">
            <section id="posts-container-admin">
                {% for post in posts %}
                    <article class="admin-post-card">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 1rem;">
                            <span class="admin-badge">Post ID #{{ post.id }}</span>
                            <small style="color: #94a3b8;">{{ post.createdAt|date('d/m/Y H:i') }}</small>
                        </div>
                        
                        <h3 style="margin: 0 0 0.5rem 0; font-weight: 700;">{{ post.title }}</h3>
                        <p style="color: #475569; font-size: 0.95rem; line-height: 1.5;">{{ post.content }}</p>
                        
                        <div style="margin: 1rem 0; font-size: 0.85rem; color: #64748b;">
                            <i class="fas fa-user-circle"></i> Auteur: <strong>{{ post.user.nom }} {{ post.user.prenom }}</strong>
                        </div>

                        <div style="display: flex; gap: 10px; margin-top: 1.5rem; padding-top: 1.2rem; border-top: 1px solid #f1f5f9;">
                            <button class="btn-action btn-view toggle-comments-btn">
                                <i class="far fa-comments"></i> {{ post.comments|length }} Réponses
                            </button>
                            
                            <form method="post" action="{{ path('forum_delete', { id: post.id }) }}" onsubmit="return confirm('Supprimer définitivement ?');">
                                <button class="btn-action btn-del">
                                    <i class="fas fa-trash-alt"></i> Supprimer
                                </button>
                            </form>
                        </div>

                        <div class="comments-section" style="display:none; margin-top: 1.5rem; background: #f8fafc; padding: 1rem; border-radius: 12px;">
                            {% for comment in post.comments %}
                                <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; border-bottom: 1px solid #eef2f6;">
                                    <p style="margin:0; font-size: 0.9rem;">{{ comment.content }}</p>
                                    <form method="post" action="{{ path('comment_delete', { id: comment.id }) }}">
                                        <button style="background:none; border:none; color:var(--admin-secondary); cursor:pointer;"><i class="fas fa-times"></i></button>
                                    </form>
                                </div>
                            {% endfor %}
                        </div>
                    </article>
                {% endfor %}
            </section>

            <aside>
                <div class="stat-box">
                    <div class="stat-icon" style="background: #eff6ff; color: var(--admin-primary);"><i class="fas fa-envelope-open-text"></i></div>
                    <div>
                        <div style="font-size: 1.5rem; font-weight: 800;">{{ posts|length }}</div>
                        <div style="font-size: 0.8rem; color: #64748b;">Discussions</div>
                    </div>
                </div>
                <div class="stat-box">
                    <div class="stat-icon" style="background: #fff1f2; color: var(--admin-secondary);"><i class="fas fa-comment-dots"></i></div>
                    <div>
                        <div style="font-size: 1.5rem; font-weight: 800;">{{ comments|length }}</div>
                        <div style="font-size: 0.8rem; color: #64748b;">Commentaires</div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>

<script>
    // Toggle Commentaires
    document.querySelectorAll('.toggle-comments-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const section = btn.closest('article').querySelector('.comments-section');
            section.style.display = section.style.display === 'none' ? 'block' : 'none';
        });
    });

    // Recherche simple
    document.getElementById('search-admin').addEventListener('input', function(e) {
        const text = e.target.value.toLowerCase();
        document.querySelectorAll('.admin-post-card').forEach(card => {
            const title = card.querySelector('h3').textContent.toLowerCase();
            card.style.display = title.includes(text) ? 'block' : 'none';
        });
    });
</script>
{% endblock %}